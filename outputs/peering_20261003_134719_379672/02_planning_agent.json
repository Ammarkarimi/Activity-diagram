  "decision_strategy": [
    "Start with resource publication and update paths before peering initiation.",
    "Treat initiation as rejected when requests are malicious, timed out, or otherwise unacceptable under policy.",
    "Use long-term peering policies when available; otherwise perform short-term negotiation.",
